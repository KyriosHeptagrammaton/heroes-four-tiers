; Heroes of Four Seasons — Godot 4 project
config_version=5

[application]
config/name="Heroes of Four Seasons"
config/description="An abstract Heroes-of-Might-and-Magic-style strategy prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="HeroesFourTiers"
config/icon="res://icon.svg"

[autoload]
D="*res://scripts/core/data.gd"
U="*res://scripts/core/util.gd"
Units="*res://scripts/rules/units.gd"
Heroes="*res://scripts/rules/heroes.gd"
CombatAI="*res://scripts/rules/combat_ai.gd"
Army="*res://scripts/rules/army.gd"
WorldGen="*res://scripts/rules/world_gen.gd"
World="*res://scripts/rules/world.gd"
Game="*res://scripts/game.gd"
UI="*res://scripts/ui/ui.gd"
Music="*res://scripts/ui/music.gd"
Sfx="*res://scripts/ui/sfx.gd"
ArmyUI="*res://scripts/ui/army_ui.gd"
Main="*res://scripts/ui/main_menu.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="disabled"
window/subwindows/embed_subwindows=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/canvas_textures/default_texture_repeat=1
